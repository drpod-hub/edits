# Copie para .env e preencha. Nunca envie o .env nem o certificado para o GitHub.

# Certificado A1 (.pfx ou .p12) da empresa que RECEBE as notas
CERT_PFX=certificado.pfx
CERT_SENHA=

# Sigla do estado do CNPJ do certificado (ex.: SP, MG, PR)
UF=SP

# CNPJ (ou CPF) do interessado. Em branco = lê do certificado.
CNPJ=

# 1 = produção, 2 = homologação
AMBIENTE=1

# Registrar "Ciência da Operação" automaticamente para liberar o XML completo (1 = sim, 0 = não)
MANIFESTAR_CIENCIA=1

# Cadeia ICP-Brasil para validar o HTTPS da SEFAZ (gerada por "npm run cadeia")
SEFAZ_CA=icp-brasil.pem

# Servidor. Para abrir a outras máquinas use HOST=0.0.0.0 e defina TOKEN_ACESSO.
PORTA=3000
HOST=127.0.0.1
TOKEN_ACESSO=
